<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AlienRace.ThingDef_AlienRace ParentName="Human">
    <defName>Euclidi_HARRaceProbe</defName>
    <label>race probe</label>
    <description>A development-only test of custom race identity and skin tint.</description>
    <alienRace>
      <generalSettings>
        <humanRecipeImport>true</humanRecipeImport>
        <alienPartGenerator>
          <colorChannels Inherit="False">
            <li>
              <name>skin</name>
              <first Class="ColorGenerator_Options">
                <options>
                  <li><weight>4</weight><only>RGBA(105, 130, 79, 255)</only></li>
                  <li><weight>3</weight><only>RGBA(77, 108, 65, 255)</only></li>
                  <li><weight>2</weight><only>RGBA(141, 151, 93, 255)</only></li>
                </options>
              </first>
              <second Class="ColorGenerator_Single"><color>RGBA(255, 255, 255, 255)</color></second>
            </li>
          </colorChannels>
        </alienPartGenerator>
      </generalSettings>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>Euclidi_HARRaceProbeColonist</defName>
    <label>race probe colonist</label>
    <race>Euclidi_HARRaceProbe</race>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <initialResistanceRange>13~21</initialResistanceRange>
  </PawnKindDef>
</Defs>
